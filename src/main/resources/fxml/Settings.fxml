<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.mrlongnight.photonjockey.ui.SettingsController"
            prefWidth="500.0" styleClass="dashboard-root" stylesheets="@../css/dashboard.css">

    <center>
        <GridPane hgap="10" vgap="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Theme -->
            <Label text="Theme:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="themeComboBox" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- Control Style -->
            <Label text="Control Style:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="controlStyleComboBox" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Log File Path -->
            <Label text="Log File Path:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="1">
                <TextField fx:id="logPathTextField" prefWidth="200" HBox.hgrow="ALWAYS"/>
                <Button fx:id="browseButton" text="Browse..."/>
            </HBox>

            <!-- Console Log Level -->
            <Label text="Console Log Level:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="consoleLogLevelComboBox" prefWidth="250" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- File Log Level -->
            <Label text="File Log Level:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <ComboBox fx:id="fileLogLevelComboBox" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button fx:id="saveButton" text="Save" onAction="#handleSave" styleClass="primary"/>
            <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"/>
        </HBox>
    </bottom>

</BorderPane>

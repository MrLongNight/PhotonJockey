<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="io.github.mrlongnight.photonjockey.ui.AudioAnalyzerDashboardController"
            prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #1e1e1e;">
    
    <top>
        <VBox fx:id="topVBox" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            
            <!-- Control Panel -->
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #2b2b2b; -fx-padding: 10;">
                <!-- Audio Device Selection -->
                <Label text="Audio Device:" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                <ComboBox fx:id="audioDeviceComboBox" prefWidth="250" promptText="Select Audio Device"/>
                <Button fx:id="refreshDevicesButton" text="Refresh" onAction="#onRefreshDevices"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Level:" style="-fx-text-fill: #ffffff;"/>
                <ProgressBar fx:id="levelProgressBar" prefWidth="200" progress="0.0"/>

                <Separator orientation="VERTICAL"/>

                <CheckBox fx:id="visualizationsCheckbox" text="Enable Visualizations" selected="true" style="-fx-text-fill: #ffffff;"/>

                <Separator orientation="VERTICAL"/>

                <Button fx:id="settingsButton" text="Settings"/>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <Accordion>
            <!-- Waveform Visualization -->
            <TitledPane text="Waveform" expanded="true" animated="true">
                <content>
                    <VBox spacing="5">
                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                        <Canvas fx:id="waveformCanvas" height="120"
                                style="-fx-border-color: #444444; -fx-border-width: 1;"/>
                    </VBox>
                </content>
            </TitledPane>
            
            <!-- Frequency Spectrum -->
            <TitledPane text="Frequency Spectrum" expanded="true" animated="true">
                <content>
                    <VBox spacing="5">
                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                        <Canvas fx:id="spectrumCanvas" height="120"
                                style="-fx-border-color: #444444; -fx-border-width: 1;"/>
                    </VBox>
                </content>
            </TitledPane>

            <!-- Low Frequency Spectrum -->
            <TitledPane text="Low Frequency Spectrum" expanded="false" animated="true">
                <content>
                    <VBox spacing="5">
                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                        <Canvas fx:id="lowFreqCanvas" height="120"
                                style="-fx-border-color: #444444; -fx-border-width: 1;"/>
                    </VBox>
                </content>
            </TitledPane>

            <!-- Mid Frequency Spectrum -->
            <TitledPane text="Mid Frequency Spectrum" expanded="false" animated="true">
                <content>
                    <VBox spacing="5">
                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                        <Canvas fx:id="midFreqCanvas" height="120"
                                style="-fx-border-color: #444444; -fx-border-width: 1;"/>
                    </VBox>
                </content>
            </TitledPane>

            <!-- High Frequency Spectrum -->
            <TitledPane text="High Frequency Spectrum" expanded="false" animated="true">
                <content>
                    <VBox spacing="5">
                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                        <Canvas fx:id="highFreqCanvas" height="120"
                                style="-fx-border-color: #444444; -fx-border-width: 1;"/>
                    </VBox>
                </content>
            </TitledPane>

            <!-- Analytics Display -->
            <TitledPane text="Analytics" expanded="true" animated="true">
                <content>
                    <HBox spacing="10" alignment="CENTER">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <!-- Beat Indicator -->
                        <VBox spacing="5" styleClass="analytic-pane" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label text="BEAT INDICATOR" styleClass="analytic-title"/>
                            <StackPane fx:id="beatIndicatorPane" prefHeight="50" styleClass="beat-indicator-pane">
                                 <Label text="--" styleClass="analytic-value-small"/>
                            </StackPane>
                        </VBox>

                        <!-- BPM Display -->
                        <VBox spacing="5" styleClass="analytic-pane" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label text="BPM" styleClass="analytic-title"/>
                            <Label fx:id="bpmLabel" text="0.0" styleClass="analytic-value"/>
                        </VBox>
                    </HBox>
                </content>
            </TitledPane>
        </Accordion>
    </center>
    
    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TitledPane text="Frequency Bands" expanded="false" animated="true">
                <content>
                    <VBox spacing="15" style="-fx-background-color: #2b2b2b;">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Low Freq:" minWidth="120" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                            <Slider fx:id="lowFreqSlider" min="20" max="500" value="150"
                                    showTickMarks="true" showTickLabels="false"
                                    majorTickUnit="100" minorTickCount="4" blockIncrement="10"/>
                            <Label fx:id="lowFreqValueLabel" text="150 Hz" minWidth="50"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Mid Freq:" minWidth="120" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                            <Slider fx:id="midFreqSlider" min="500" max="5000" value="2000"
                                    showTickMarks="true" showTickLabels="false"
                                    majorTickUnit="1000" minorTickCount="4" blockIncrement="100"/>
                            <Label fx:id="midFreqValueLabel" text="2000 Hz" minWidth="50"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="High Freq:" minWidth="120" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                            <Slider fx:id="highFreqSlider" min="5000" max="20000" value="10000"
                                    showTickMarks="true" showTickLabels="false"
                                    majorTickUnit="5000" minorTickCount="4" blockIncrement="500"/>
                            <Label fx:id="highFreqValueLabel" text="10000 Hz" minWidth="50"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                        </HBox>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="Audio Settings" expanded="true" animated="true">
                <content>
                    <VBox spacing="15" style="-fx-background-color: #2b2b2b;">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>

                        <!-- Gain Slider -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Gain:" minWidth="120" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                            <Slider fx:id="gainSlider" min="0.0" max="2.0" value="1.0"
                                    showTickMarks="true" showTickLabels="false"
                                    majorTickUnit="0.5" minorTickCount="4" blockIncrement="0.1"/>
                            <Label fx:id="gainValueLabel" text="1.00" minWidth="50"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                        </HBox>

                        <!-- Beat Sensitivity Slider -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Beat Sensitivity:" minWidth="120" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                            <Slider fx:id="beatSensitivitySlider" min="0.5" max="2.0" value="1.3"
                                    showTickMarks="true" showTickLabels="false"
                                    majorTickUnit="0.5" minorTickCount="4" blockIncrement="0.1"/>
                            <Label fx:id="beatSensitivityValueLabel" text="1.30" minWidth="50"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                        </HBox>

                        <!-- Min/Max BPM Sliders -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Min BPM:" minWidth="120" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                            <Slider fx:id="minBpmSlider" min="60" max="180" value="80"
                                    showTickMarks="true" showTickLabels="false"
                                    majorTickUnit="20" minorTickCount="4" blockIncrement="5"/>
                            <Label fx:id="minBpmValueLabel" text="80" minWidth="50"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Max BPM:" minWidth="120" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                            <Slider fx:id="maxBpmSlider" min="60" max="180" value="160"
                                    showTickMarks="true" showTickLabels="false"
                                    majorTickUnit="20" minorTickCount="4" blockIncrement="5"/>
                            <Label fx:id="maxBpmValueLabel" text="160" minWidth="50"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Min Beat Interval (ms):" minWidth="120" style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                            <Slider fx:id="minBeatIntervalSlider" min="0" max="500" value="200"
                                    showTickMarks="true" showTickLabels="false"
                                    majorTickUnit="100" minorTickCount="4" blockIncrement="10"/>
                            <Label fx:id="minBeatIntervalValueLabel" text="200" minWidth="50"
                                   style="-fx-text-fill: #ffffff; -fx-font-size: 12px;"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <CheckBox fx:id="bassOnlyModeCheckbox" text="Bass Only Mode" style="-fx-text-fill: #ffffff;"/>
                        </HBox>
                    </VBox>
                </content>
            </TitledPane>
        </VBox>
    </bottom>

</BorderPane>
